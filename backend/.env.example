APP_NAME=Addis Journal
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://blog:blog@localhost:5432/blog
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
